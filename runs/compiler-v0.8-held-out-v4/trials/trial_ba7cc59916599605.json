 later. So, if you do work in December but are paid in January, accrual shows the income in December; cash basis shows it in January. Accrual gives a clearer picture of how the business is doing over time; cash basis is easier to keep and focused on actual cash on hand. ([openstax.org](https://openstax.org/books/principles-finance-2e/pages/4-1-cash-versus-accrual-accounting?utm_source=openai))","runId":"run_16f13bd723767d59","sampleIndex":2,"schemaVersion":"2.0.0","status":"completed","strategy":"compiler_slice","structuralRetention":{"allArtifactCriticalPoliciesRetained":true,"criticalPolicyIds":["universal_honesty","no_hidden_reasoning_reveal","no_background_work_claims","do_not_mention_internal_policy","do_not_invent_facts","no_raw_tool_json_exposure","privacy_floor","authoritative_sources_preferred"],"selectedPolicyIds":["universal_honesty","no_hidden_reasoning_reveal","no_background_work_claims","do_not_mention_internal_policy","do_not_invent_facts","no_raw_tool_json_exposure","privacy_floor","citations_required","authoritative_sources_preferred","citation_definition"]},"toolCalls":[{"id":"ws_0b2b81abb0b02d9c016a9a0790049c87d0854aa72ad28a8678","name":"web","status":"completed","type":"web_search"}],"toolCostUsd":0.01,"totalTokens":10305,"trialId":"trial_ba7cc59916599605"}
