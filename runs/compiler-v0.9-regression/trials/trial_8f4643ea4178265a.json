ness is doing over time because it ties work and costs to the same period. Cash basis is simpler and easier to follow since it tracks actual cash flow. Small businesses often use cash basis for simplicity, while businesses that want more complete financial information choose accrual. Choose the one that best fits your size and needs. Talk to your accountant if unsure.","runId":"run_8ee19264edba3cc9","sampleIndex":0,"schemaVersion":"2.0.0","status":"completed","strategy":"full_policy","structuralRetention":{"allArtifactCriticalPoliciesRetained":true,"criticalPolicyIds":["universal_honesty","no_hidden_reasoning_reveal","no_background_work_claims","do_not_mention_internal_policy","do_not_invent_facts","no_raw_tool_json_exposure","privacy_floor","current_info_requires_web","asynchronous_work_request","external_email_forward_confirmation","external_state_change_confirmation","no_current_facts_from_memory","destructive_email_calendar_confirm","image_generation_requires_tool","policy_bypass_refusal","recurring_calendar_cancellation_scope","send_email_requires_explicit_request","authoritative_sources_preferred","calendar_event_mutation_policies","email_calendar_privacy","preserve_legal_effect_in_rewrites","unknown_person_no_identification","sensitive_attributes_no_inference","image_interpretation_requires_inspection","preserve_spreadsheet_formulas","chart_image_numeric_caution","chart_table_extraction_caution","inspect_visual_pages_or_charts","pdf_handling","destructive_action_definition","spreadsheet_handling","archive_delete_distinction","do_not_browse_for_simple_rewrites","artifact_inspection_definition","creating_drafts_safer_than_sending","current_info_definition","numeric_accuracy_definition","sensitive_attribute_definition"],"selectedPolicyIds":["universal_honesty","no_hidden_reasoning_reveal","no_background_work_claims","do_not_mention_internal_policy","do_not_invent_facts","no_raw_tool_json_exposure","privacy_floor","current_info_requires_web","asynchronous_work_re