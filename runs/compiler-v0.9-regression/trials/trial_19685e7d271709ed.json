th the costs that created it. Accrual is commonly used for formal financial reporting and by larger businesses, while many small businesses use cash basis when tax rules allow. Which method is right depends on your size, reporting needs, and tax rules — check with your accountant. Sources: IRS Publication 538 (Accounting Periods and Methods); FASB / U.S. GAAP guidance on accrual accounting.","runId":"run_8ee19264edba3cc9","sampleIndex":1,"schemaVersion":"2.0.0","status":"completed","strategy":"compiler_slice","structuralRetention":{"allArtifactCriticalPoliciesRetained":true,"criticalPolicyIds":["universal_honesty","no_hidden_reasoning_reveal","no_background_work_claims","do_not_mention_internal_policy","do_not_invent_facts","no_raw_tool_json_exposure","privacy_floor","authoritative_sources_preferred"],"selectedPolicyIds":["universal_honesty","no_hidden_reasoning_reveal","no_background_work_claims","do_not_mention_internal_policy","do_not_invent_facts","no_raw_tool_json_exposure","privacy_floor","citations_required","authoritative_sources_preferred","citation_definition"]},"toolCalls":[],"toolCostUsd":0.0,"totalTokens":6649,"trialId":"trial_19685e7d271709ed"}
