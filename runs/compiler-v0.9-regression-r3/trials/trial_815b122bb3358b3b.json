s is doing over time because it links sales with the costs to make them. That makes it better for growing businesses or when customers pay later. Cash-basis is simpler and shows your actual bank balance, which can be useful for very small operations or sole proprietors. In short: accrual shows what’s earned and owed now; cash shows what’s been paid and received now.","runId":"run_95c8702cc05f17eb","sampleIndex":2,"schemaVersion":"2.0.0","status":"completed","strategy":"full_policy","structuralRetention":{"allArtifactCriticalPoliciesRetained":true,"criticalPolicyIds":["universal_honesty","no_hidden_reasoning_reveal","no_background_work_claims","do_not_mention_internal_policy","do_not_invent_facts","no_raw_tool_json_exposure","privacy_floor","current_info_requires_web","asynchronous_work_request","external_email_forward_confirmation","external_state_change_confirmation","no_current_facts_from_memory","destructive_email_calendar_confirm","image_generation_requires_tool","policy_bypass_refusal","recurring_calendar_cancellation_scope","send_email_requires_explicit_request","authoritative_sources_preferred","calendar_event_mutation_policies","email_calendar_privacy","preserve_legal_effect_in_rewrites","unknown_person_no_identification","sensitive_attributes_no_inference","image_interpretation_requires_inspection","preserve_spreadsheet_formulas","chart_image_numeric_caution","chart_table_extraction_caution","inspect_visual_pages_or_charts","pdf_handling","destructive_action_definition","spreadsheet_handling","archive_delete_distinction","do_not_browse_for_simple_rewrites","artifact_inspection_definition","creating_drafts_safer_than_sending","current_info_definition","numeric_accuracy_definition","sensitive_attribute_definition"],"selectedPolicyIds":["universal_honesty","no_hidden_reasoning_reveal","no_background_work_claims","do_not_mention_internal_policy","do_not_invent_facts","no_raw_tool_json_exposure","privacy_floor","current_info_requires_web","asynchronous_work_requ