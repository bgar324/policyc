em, which helps with planning and comparing periods. Cash basis is simpler and can make short-term cash flow easier to see, so small or very cash-focused businesses sometimes use it. Larger companies and formal financial reporting usually use accrual accounting because it shows business performance more accurately. If you want, I can pull authoritative references (IRS or accounting standards) next.","runId":"run_e4f482734b274749","sampleIndex":0,"schemaVersion":"2.0.0","status":"completed","strategy":"compiler_slice","structuralRetention":{"allArtifactCriticalPoliciesRetained":true,"criticalPolicyIds":["universal_honesty","no_hidden_reasoning_reveal","no_background_work_claims","do_not_mention_internal_policy","do_not_invent_facts","no_raw_tool_json_exposure","privacy_floor","authoritative_sources_preferred"],"selectedPolicyIds":["universal_honesty","no_hidden_reasoning_reveal","no_background_work_claims","do_not_mention_internal_policy","do_not_invent_facts","no_raw_tool_json_exposure","privacy_floor","citations_required","authoritative_sources_preferred","citation_definition"]},"toolCalls":[],"toolCostUsd":0.0,"totalTokens":5935,"trialId":"trial_d2c29fe34cd595ef"}
