{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policyc.dev/schema/compiled-policy-artifact-1.4.0.json",
  "title": "PolicyC compiled policy artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "compilerVersion",
    "candidateId",
    "policyPackHash",
    "sourcePolicyId",
    "sourcePolicyHash",
    "request",
    "artifactContext",
    "selectedPolicyIds",
    "directlySelectedPolicyIds",
    "dependencyAddedPolicyIds",
    "criticalPolicyIds",
    "dependencyEdges",
    "selectionReasons",
    "orderedRuntimeInstructions",
    "compiledPrompt",
    "compiledPromptHash",
    "tokenCount",
    "compilationStrategy",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0",
        "1.4.0"
      ]
    },
    "compilerVersion": {
      "type": "string"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^cand_[a-f0-9]{16}$"
    },
    "policyPackHash": {
      "$ref": "#/$defs/hash"
    },
    "sourcePolicyId": {
      "type": "string"
    },
    "sourcePolicyHash": {
      "$ref": "#/$defs/hash"
    },
    "request": {
      "type": "string"
    },
    "artifactContext": {
      "type": [
        "object",
        "null"
      ]
    },
    "selectedPolicyIds": {
      "$ref": "#/$defs/strings"
    },
    "directlySelectedPolicyIds": {
      "$ref": "#/$defs/strings"
    },
    "dependencyAddedPolicyIds": {
      "$ref": "#/$defs/strings"
    },
    "criticalPolicyIds": {
      "$ref": "#/$defs/strings"
    },
    "dependencyEdges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "requires"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "requires": {
            "type": "string"
          }
        }
      }
    },
    "selectionReasons": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "orderedRuntimeInstructions": {
      "$ref": "#/$defs/strings"
    },
    "compiledPrompt": {
      "type": "string"
    },
    "compiledPromptHash": {
      "$ref": "#/$defs/hash"
    },
    "tokenCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "method",
        "tokenizer"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "method": {
          "enum": [
            "exact",
            "estimated"
          ]
        },
        "tokenizer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "compilationStrategy": {
      "enum": [
        "full_policy",
        "compiler_slice",
        "kernel_only",
        "direct_matches",
        "conservative_expanded",
        "source_preserving_slice",
        "source_matched_semantic",
        "source_matched_authored",
        "source_clause_slice",
        "source_evidence_bare",
        "source_evidence_apply",
        "model_reader_slice",
        "condition_list_slice"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestState": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorization",
            "limit",
            "deliverable",
            "purpose",
            "permittedTask",
            "format",
            "fields",
            "operationNamed",
            "operationNegated",
            "frontend",
            "evidence"
          ],
          "properties": {
            "operation": {
              "type": "string"
            },
            "artifactType": {
              "type": "string"
            },
            "currentInformation": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "deferredWork": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "slideTask": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "externalDisclosure": {
              "enum": [
                "safe",
                "confidential_external",
                "unknown"
              ]
            },
            "requestedSlideReorder": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "authorization": {
              "enum": [
                "present",
                "reported",
                "conditional",
                "absent"
              ]
            },
            "limit": {
              "enum": [
                "limited",
                "ambiguous",
                "none"
              ]
            },
            "deliverable": {
              "enum": [
                "text",
                "open",
                "unresolved"
              ]
            },
            "purpose": {
              "enum": [
                "sensitive_attribute_read",
                "identification",
                "none"
              ]
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "operationNamed": {
              "type": "boolean"
            },
            "operationNegated": {
              "type": "boolean"
            },
            "toolsAvailable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "frontend": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "permittedTask": {
              "type": "boolean"
            },
            "format": {
              "enum": [
                "requested",
                "none"
              ]
            }
          }
        }
      ]
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policyId",
          "branchId",
          "truth",
          "evidence"
        ],
        "properties": {
          "policyId": {
            "type": "string"
          },
          "branchId": {
            "type": "string"
          },
          "truth": {
            "enum": [
              "true",
              "false",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Protocol 1.1.0 trace; superseded by requestState and evaluations in 1.2.0 and later."
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceSelection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Protocol 1.4.0 source-slice provenance. Sections are half-open UTF-8 byte spans of the original source in original order. Omissions are current-selector predictions, not proven irrelevance; unmapped or unresolved context is retained. This is not proof of semantic equivalence. endByte > startByte, source ordering, and span disjointness are enforced by the runtime reader, which JSON Schema cannot express.",
      "required": [
        "contractVersion",
        "selectionBasis",
        "sourceMapHash",
        "seedPolicyIds",
        "sections"
      ],
      "properties": {
        "contractVersion": {
          "const": "source-sections-v1"
        },
        "selectionBasis": {
          "const": "current-selector-prediction"
        },
        "sourceMapHash": {
          "$ref": "#/$defs/hash"
        },
        "seedPolicyIds": {
          "$ref": "#/$defs/strings"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "heading",
              "startByte",
              "endByte",
              "sha256",
              "policyIds",
              "retained",
              "context",
              "reasons"
            ],
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "startByte": {
                "type": "integer",
                "minimum": 0
              },
              "endByte": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "policyIds": {
                "$ref": "#/$defs/strings"
              },
              "retained": {
                "type": "boolean"
              },
              "context": {
                "type": "boolean"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "context"
                  ],
                  "properties": {
                    "context": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "retained": {
                      "const": true
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "retained"
                  ],
                  "properties": {
                    "retained": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reasons": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "sourceClauseSelection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Protocol 1.4.0 clause-level provenance for source_clause_slice. Every span is one whole source line. Retention cites a positive selector signal or a source-semantic dependency; pruning cites the exhaustive structural fact that justified it. Boilerplate records one canonical copy and the label-only copies it subsumes. Ordering, non-overlap, dependency closure, and the pruning-reason rule are enforced by the runtime reader.",
      "required": [
        "contractVersion",
        "clauseMapHash",
        "exhaustive",
        "seedPolicyIds",
        "retainedSections",
        "clauses",
        "boilerplate"
      ],
      "properties": {
        "contractVersion": {
          "const": "source-clauses-v1"
        },
        "clauseMapHash": {
          "$ref": "#/$defs/hash"
        },
        "exhaustive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifacts",
            "tools"
          ],
          "properties": {
            "artifacts": {
              "type": "boolean"
            },
            "tools": {
              "type": "boolean"
            }
          }
        },
        "seedPolicyIds": {
          "$ref": "#/$defs/strings"
        },
        "retainedSections": {
          "$ref": "#/$defs/strings"
        },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "section",
              "line",
              "startByte",
              "endByte",
              "sha256",
              "retained",
              "dependsOn",
              "reasons"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "startByte": {
                "type": "integer",
                "minimum": 0
              },
              "endByte": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "retained": {
                "type": "boolean"
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "boilerplate": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "line",
              "startByte",
              "endByte",
              "sha256",
              "retained",
              "subsumes"
            ],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "startByte": {
                "type": "integer",
                "minimum": 0
              },
              "endByte": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "retained": {
                "type": "boolean"
              },
              "subsumes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "section",
                    "line",
                    "startByte",
                    "endByte",
                    "sha256"
                  ],
                  "properties": {
                    "section": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "startByte": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "endByte": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "sha256": {
                      "$ref": "#/$defs/hash"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Protocol 1.4.0 evidence binding for the source_evidence_* arms. Verbatim request sentences bound to retained clauses and proposed actions, tagged with the evidence roles they touch. No field is a verdict; the reader quotes and never judges.",
      "required": [
        "contractVersion",
        "evidenceContractHash",
        "request",
        "actions",
        "bindings"
      ],
      "properties": {
        "contractVersion": {
          "const": "source-evidence-v1"
        },
        "evidenceContractHash": {
          "$ref": "#/$defs/hash"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "sentences"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/hash"
            },
            "sentences": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "operation",
              "sentence",
              "phrase"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "sentence": {
                "type": "integer",
                "minimum": -1
              },
              "phrase": {
                "type": "string"
              }
            }
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clause",
              "action",
              "roles",
              "quotes"
            ],
            "properties": {
              "clause": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "requirement"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "requirement": {
                      "type": "string"
                    }
                  }
                }
              },
              "quotes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sentence",
                    "start",
                    "end",
                    "text",
                    "roles"
                  ],
                  "properties": {
                    "sentence": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "text": {
                      "type": "string"
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "policyReading": {
      "type": "object",
      "additionalProperties": false,
      "description": "Protocol 1.4.0 model_reader_slice provenance: a model reader's resolutions of the policy's own conditions for this request. Contract 1 resolutions quote the condition the reader found; contract 2 resolutions answer a listed condition by id with a verdict and the deciding words. Only the directives are rendered after the clause slice. Not a verdict on preservation.",
      "required": [
        "readerId",
        "readingContractSha256",
        "resolutions"
      ],
      "properties": {
        "readerId": {
          "type": "string",
          "minLength": 1
        },
        "readingContractSha256": {
          "$ref": "#/$defs/hash"
        },
        "resolutions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "condition",
                  "finding",
                  "directive"
                ],
                "properties": {
                  "condition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "finding": {
                    "type": "string",
                    "minLength": 1
                  },
                  "directive": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "condition",
                  "holds",
                  "quote",
                  "directive"
                ],
                "properties": {
                  "condition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "holds": {
                    "enum": [
                      "yes",
                      "no",
                      "undecidable",
                      "not-applicable"
                    ]
                  },
                  "quote": {
                    "type": "string"
                  },
                  "directive": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "policyConditions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Protocol 1.4.0 provenance for the indexed conditions listed for this request: rendered after the slice by condition_list_slice, and answered by a contract-2 model_reader_slice reading. The index is a hand-audited, verbatim projection of the source; nothing here is a verdict.",
      "required": [
        "conditionIndexHash",
        "conditions"
      ],
      "properties": {
        "conditionIndexHash": {
          "$ref": "#/$defs/hash"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clause",
              "id",
              "sentence",
              "condition"
            ],
            "properties": {
              "clause": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sentence": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              "1.2.0",
              "1.3.0",
              "1.4.0"
            ]
          }
        }
      },
      "then": {
        "required": [
          "requestState",
          "evaluations",
          "conflicts"
        ]
      },
      "else": {
        "if": {
          "properties": {
            "schemaVersion": {
              "const": "1.1.0"
            }
          }
        },
        "then": {
          "required": [
            "specializations"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              "1.3.0",
              "1.4.0"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "requestState": {
            "type": "object",
            "required": [
              "currentInformation",
              "deferredWork",
              "slideTask",
              "externalDisclosure",
              "requestedSlideReorder"
            ],
            "properties": {
              "artifactType": {
                "enum": [
                  "pdf",
                  "spreadsheet",
                  "image",
                  "document",
                  "email",
                  "calendar_event",
                  "generated_image",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "schemaVersion"
        ],
        "properties": {
          "schemaVersion": {
            "const": "1.4.0"
          }
        }
      },
      "then": {
        "properties": {
          "compilationStrategy": {
            "enum": [
              "source_preserving_slice",
              "source_matched_semantic",
              "source_matched_authored",
              "source_clause_slice",
              "source_evidence_bare",
              "source_evidence_apply",
              "model_reader_slice",
              "condition_list_slice"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "compilationStrategy": {
                  "enum": [
                    "source_clause_slice",
                    "source_evidence_bare",
                    "source_evidence_apply",
                    "model_reader_slice",
                    "condition_list_slice"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "sourceClauseSelection"
              ],
              "not": {
                "required": [
                  "sourceSelection"
                ]
              }
            },
            "else": {
              "required": [
                "sourceSelection"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "sourceClauseSelection"
                    ]
                  },
                  {
                    "required": [
                      "sourceEvidence"
                    ]
                  },
                  {
                    "required": [
                      "policyReading"
                    ]
                  },
                  {
                    "required": [
                      "policyConditions"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "compilationStrategy": {
                  "enum": [
                    "source_evidence_bare",
                    "source_evidence_apply"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "sourceEvidence"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "sourceEvidence"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "compilationStrategy": {
                  "const": "model_reader_slice"
                }
              }
            },
            "then": {
              "required": [
                "policyReading"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "policyReading"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "compilationStrategy": {
                  "const": "condition_list_slice"
                }
              }
            },
            "then": {
              "required": [
                "policyConditions"
              ]
            },
            "else": {
              "if": {
                "properties": {
                  "compilationStrategy": {
                    "const": "model_reader_slice"
                  }
                }
              },
              "then": {},
              "else": {
                "not": {
                  "required": [
                    "policyConditions"
                  ]
                }
              }
            }
          }
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "sourceSelection"
              ]
            },
            {
              "required": [
                "sourceClauseSelection"
              ]
