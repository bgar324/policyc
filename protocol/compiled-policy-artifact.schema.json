{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policyc.dev/schema/compiled-policy-artifact-1.2.0.json",
  "title": "PolicyC compiled policy artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "compilerVersion",
    "candidateId",
    "policyPackHash",
    "sourcePolicyId",
    "sourcePolicyHash",
    "request",
    "artifactContext",
    "selectedPolicyIds",
    "directlySelectedPolicyIds",
    "dependencyAddedPolicyIds",
    "criticalPolicyIds",
    "dependencyEdges",
    "selectionReasons",
    "orderedRuntimeInstructions",
    "compiledPrompt",
    "compiledPromptHash",
    "tokenCount",
    "compilationStrategy",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "compilerVersion": {
      "type": "string"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^cand_[a-f0-9]{16}$"
    },
    "policyPackHash": {
      "$ref": "#/$defs/hash"
    },
    "sourcePolicyId": {
      "type": "string"
    },
    "sourcePolicyHash": {
      "$ref": "#/$defs/hash"
    },
    "request": {
      "type": "string"
    },
    "artifactContext": {
      "type": [
        "object",
        "null"
      ]
    },
    "selectedPolicyIds": {
      "$ref": "#/$defs/strings"
    },
    "directlySelectedPolicyIds": {
      "$ref": "#/$defs/strings"
    },
    "dependencyAddedPolicyIds": {
      "$ref": "#/$defs/strings"
    },
    "criticalPolicyIds": {
      "$ref": "#/$defs/strings"
    },
    "dependencyEdges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "requires"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "requires": {
            "type": "string"
          }
        }
      }
    },
    "selectionReasons": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "orderedRuntimeInstructions": {
      "$ref": "#/$defs/strings"
    },
    "compiledPrompt": {
      "type": "string"
    },
    "compiledPromptHash": {
      "$ref": "#/$defs/hash"
    },
    "tokenCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "method",
        "tokenizer"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "method": {
          "enum": [
            "exact",
            "estimated"
          ]
        },
        "tokenizer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "compilationStrategy": {
      "enum": [
        "full_policy",
        "compiler_slice",
        "kernel_only",
        "direct_matches",
        "conservative_expanded"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestState": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorization",
            "limit",
            "deliverable",
            "purpose",
            "permittedTask",
            "fields",
            "operationNamed",
            "operationNegated",
            "frontend",
            "evidence"
          ],
          "properties": {
            "operation": {
              "type": "string"
            },
            "artifactType": {
              "type": "string"
            },
            "authorization": {
              "enum": [
                "present",
                "reported",
                "conditional",
                "absent"
              ]
            },
            "limit": {
              "enum": [
                "limited",
                "ambiguous",
                "none"
              ]
            },
            "deliverable": {
              "enum": [
                "text",
                "open",
                "unresolved"
              ]
            },
            "purpose": {
              "enum": [
                "sensitive_attribute_read",
                "identification",
                "none"
              ]
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "operationNamed": {
              "type": "boolean"
            },
            "operationNegated": {
              "type": "boolean"
            },
            "toolsAvailable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "frontend": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "permittedTask": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policyId",
          "branchId",
          "truth",
          "evidence"
        ],
        "properties": {
          "policyId": {
            "type": "string"
          },
          "branchId": {
            "type": "string"
          },
          "truth": {
            "enum": [
              "true",
              "false",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Protocol 1.1.0 trace; superseded by requestState and evaluations in 1.2.0."
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "if": {
    "properties": {
      "schemaVersion": {
        "const": "1.2.0"
      }
    }
  },
  "then": {
    "required": [
      "requestState",
      "evaluations",
      "conflicts"
    ]
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "else": {
    "if": {
      "properties": {
        "schemaVersion": {
          "const": "1.1.0"
        }
      }
    },
    "then": {
      "required": [
        "specializations"
      ]
    }
  }
}
