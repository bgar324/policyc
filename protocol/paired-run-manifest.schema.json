{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policyc.dev/schema/paired-run-manifest-2.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "experimentName",
    "dataset",
    "compilerHash",
    "casePlans",
    "strategies",
    "provider",
    "model",
    "modelParameters",
    "sampleCount",
    "maxConcurrency",
    "timeoutSeconds",
    "retryPolicy",
    "rateLimit",
    "evaluator",
    "grader",
    "budget",
    "pricing",
    "outputDirectory",
    "rawResponseRetention",
    "createdAt",
    "frontend"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "runId": {
      "type": "string"
    },
    "runLabel": {
      "type": "string"
    },
    "sourceControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "commit",
        "dirty"
      ],
      "properties": {
        "system": {
          "const": "git"
        },
        "commit": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "experimentName": {
      "type": "string"
    },
    "dataset": {
      "type": "object"
    },
    "compilerHash": {
      "type": "string"
    },
    "casePlans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "case",
          "candidates"
        ],
        "properties": {
          "caseId": {
            "type": "string"
          },
          "case": {
            "type": "object"
          },
          "candidates": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy",
                "candidateId",
                "artifactPath"
              ],
              "properties": {
                "strategy": {
                  "type": "string"
                },
                "candidateId": {
                  "type": "string"
                },
                "artifactPath": {
                  "type": "string"
                },
                "estimatedInputTokens": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "strategies": {
      "type": "array",
      "minItems": 2
    },
    "provider": {
      "enum": [
        "fake",
        "openai"
      ]
    },
    "model": {
      "type": "string"
    },
    "modelParameters": {
      "type": "object",
      "required": [
        "max_output_tokens"
      ]
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 1
    },
    "inputTokenOverheadPerCall": {
      "type": "integer",
      "minimum": 0
    },
    "maxConcurrency": {
      "type": "integer",
      "minimum": 1
    },
    "timeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "retryPolicy": {
      "type": "object"
    },
    "rateLimit": {
      "type": "object"
    },
    "evaluator": {
      "type": "object"
    },
    "grader": {
      "type": "object"
    },
    "budget": {
      "type": "object",
      "required": [
        "maxLogicalTrials",
        "maxCalls",
        "maxInputTokens",
        "maxOutputTokens",
        "maxCostUsd"
      ]
    },
    "pricing": {
      "type": "object"
    },
    "outputDirectory": {
      "type": "string"
    },
    "rawResponseRetention": {
      "const": "full"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontendId"
      ],
      "properties": {
        "frontendId": {
          "type": "string",
          "minLength": 1
        },
        "readContractSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "readsPath": {
          "type": "string"
        },
        "readsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "description": "Frontend that produced this run's request states and therefore its compiled artifacts. frontendId 'deterministic' means the in-process baseline; any other id names a persisted reads file (readsPath) whose sha256 is readsSha256. New persisted reads also bind frontendId to their complete semantic contract with readContractSha256; historical manifests may omit it."
    }
  }
}
